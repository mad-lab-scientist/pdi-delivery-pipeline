# {{ ansible_managed }}
[Unit]
Description=Prometheus node_exporter {{ node_exporter_version }}
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
ExecStart=/usr/local/bin/node_exporter \
  --web.listen-address={{ node_exporter_listen }}{% for c in node_exporter_collectors_enabled %} \
  --collector.{{ c }}{% endfor %}{% for c in node_exporter_collectors_disabled %} \
  --no-collector.{{ c }}{% endfor %}

Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
