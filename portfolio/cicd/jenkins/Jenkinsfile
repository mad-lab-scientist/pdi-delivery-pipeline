// Declarative Jenkins pipeline: lint, test, build+scan a container, Terraform plan, then a gated apply.
// Agents are labelled 'linux' with Docker and Terraform available. Credentials come from the Jenkins store.
pipeline {
  agent none
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    timeout(time: 60, unit: 'MINUTES')
  }
  environment {
    IMAGE = "registry.example.com/storefront/web:${env.GIT_COMMIT.take(12)}"
  }
  stages {
    stage('Quality gates') {
      agent { label 'linux' }
      stages {
        stage('Lint') {
          steps {
            sh 'yamllint .'
            sh "find . -name '*.sh' -not -path './.git/*' -print0 | xargs -0 -r shellcheck -x"
            sh 'terraform -chdir=terraform fmt -check -recursive'
          }
        }
        stage('Unit tests') {
          steps { sh 'python3 -m unittest discover -s portfolio/network/tests' }
        }
        stage('Build image') {
          steps { sh 'docker build -t "$IMAGE" .' }
        }
        stage('Scan image') {
          steps {
            sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed "$IMAGE"'
          }
        }
        stage('Terraform plan') {
          steps {
            dir('terraform/environments/prod-aws') {
              sh 'terraform init -input=false'
              sh 'terraform plan -input=false -out=plan.tfplan'
            }
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'terraform/environments/prod-aws/plan.tfplan', allowEmptyArchive: true }
      }
    }
    stage('Approve deploy') {
      when { branch 'main' }
      options { timeout(time: 1, unit: 'DAYS') }
      steps { input message: 'Push image and apply the Terraform plan to production?', ok: 'Deploy' }
    }
    stage('Deploy') {
      when { branch 'main' }
      agent { label 'linux' }
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh 'echo "$REG_PASS" | docker login registry.example.com -u "$REG_USER" --password-stdin'
          sh 'docker push "$IMAGE"'
        }
        dir('terraform/environments/prod-aws') {
          sh 'terraform init -input=false'
          sh 'terraform apply -input=false plan.tfplan'
        }
      }
    }
  }
}
