// Declarative Jenkins pipeline: lint, test, build+scan a container, Terraform plan, then a gated apply.
// Agents are labelled 'linux' with Docker, Trivy and Terraform available. Credentials come from the Jenkins store.
// Build once: the image that passed the scan is the image pushed (immutable commit tag). Production changes
// happen only in the gated stage, which applies the exact Terraform plan that was reviewed.
pipeline {
  agent none                       // the approval wait holds no executor
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    // Timeouts are per stage: a pipeline-level timeout would also count the approval wait and abort it.
  }
  environment {
    TF_DIR = 'terraform/environments/prod-aws'
  }
  stages {
    stage('Quality gates') {
      agent { label 'linux' }
      options { timeout(time: 60, unit: 'MINUTES') }
      // GIT_COMMIT exists only after this stage's checkout, so the image tag is set here, not at the top.
      environment { IMAGE = "registry.example.com/storefront/web:${GIT_COMMIT}" }
      stages {
        stage('Lint') {
          steps {
            sh 'yamllint .'
            sh "find . -name '*.sh' -not -path './.git/*' -print0 | xargs -0 -r shellcheck -x"
            sh 'terraform -chdir=terraform fmt -check -recursive'
          }
        }
        stage('Unit tests') {
          steps { sh 'python3 -m unittest discover -s portfolio/network/tests' }
        }
        stage('Build image') {
          steps { sh 'docker build -t "$IMAGE" .' }
        }
        stage('Scan image and IaC') {
          steps {
            sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed "$IMAGE"'
            sh 'trivy config --exit-code 1 --severity HIGH,CRITICAL terraform'
          }
        }
        stage('Push scanned image') {
          when { branch 'main' }
          steps {
            withCredentials([usernamePassword(credentialsId: 'registry', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
              sh 'echo "$REG_PASS" | docker login registry.example.com -u "$REG_USER" --password-stdin'
              sh 'docker push "$IMAGE"'
            }
          }
        }
        stage('Terraform plan') {
          steps {
            sh 'terraform -chdir="$TF_DIR" init -input=false'
            sh 'terraform -chdir="$TF_DIR" plan -input=false -out=plan.tfplan'
            // The apply stage may run on another agent or workspace: carry the exact reviewed plan.
            stash name: 'tfplan', includes: "${env.TF_DIR}/plan.tfplan"
          }
        }
      }
    }
    stage('Approve deploy') {
      when { branch 'main' }
      options { timeout(time: 1, unit: 'DAYS') }
      // submitter: the Jenkins user ID or group allowed to approve (Jenkins administrators can always approve)
      steps { input message: 'Apply the reviewed Terraform plan to production?', ok: 'Deploy', submitter: 'release-approvers' }
    }
    stage('Deploy') {
      when { branch 'main' }
      agent { label 'linux' }
      options { timeout(time: 30, unit: 'MINUTES') }
      steps {
        unstash 'tfplan'
        sh 'terraform -chdir="$TF_DIR" init -input=false'
        sh 'terraform -chdir="$TF_DIR" apply -input=false plan.tfplan'
      }
    }
  }
}
